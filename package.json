{
  "name": "pyquest",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-based Python practice workspace with real Python, instant tests and a local tutor.",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "verify:solutions": "node scripts/verify-solutions.mjs",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "check": "npm test && npm run verify:solutions"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
